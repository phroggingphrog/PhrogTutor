# ============================================
# DeepTutor (podman compose) — host-side configuration
# ============================================
# Copy to .env and edit. `.env` is gitignored.
#
# All values are loopback bindings on the HOST side. The container-side
# ports come from data/user/settings/system.json (backend_port, frontend_port).
# Edit those + `podman compose restart deeptutor` to change the in-container
# ports. This file is for shifting the host-side mapping only.
#
# The API base URL the browser uses is NOT a compose env var. The
# entrypoint reads `DEEPTUTOR_API_BASE_URL` from
# data/user/settings/system.json on every start (preferring the
# in-network `next_public_api_base`, then the external override
# `next_public_api_base_external`, then `http://localhost:${BACKEND_PORT}`),
# and web/proxy.ts rewrites /api/* and /ws/* to it at request time.
# ============================================

# Host-side loopback bindings (override if 8001/3782/8090 are taken)
HOST_PORT_BACKEND=8001
HOST_PORT_FRONTEND=3782
HOST_PORT_POCKETBASE=8090

# Time zone passed into both backend and frontend.
TZ=UTC

# ============================================
# pi-tutor (runs on the host, no container) — read by the backend
# ============================================
# Model gateway for the pi engine (any OpenAI-compatible endpoint). Overrides
# pi_engine/agent-dir/models.json (copy models.example.json and list your models there).
PI_TUTOR_LLM_BASE_URL=https://api.openai.com/v1
PI_TUTOR_LLM_API_KEY=
# Cheap model for background mastery / teaching-rule calls (empty = the active chat model).
PI_TUTOR_EXTRACT_MODEL=
# Binary that runs pi_engine/llm.ts. "bun" by default; a symlink with its own name
# (e.g. ~/.local/bin/pi-engine -> bun) lets an OOM killer such as earlyoom spare it.
PI_TUTOR_ENGINE_BIN=bun
# Code sandbox folder: pylibs/ (numpy, pandas, matplotlib, scipy for Run buttons) and
# terminal-home/ (the terminal panel's persistent home). scripts/install.sh fills it.
PI_TUTOR_RUNCODE_DIR=~/.local/share/pi-tutor-runcode
# Extra Markdown folders shown read-only in Notes, e.g. an Obsidian vault or wiki:
# label=/path;label2=/path2  (shown as @label/...)
PI_TUTOR_NOTE_SOURCES=
PI_TUTOR_UPDATE_REPO=          # owner/name of YOUR fork on GitHub; empty = no update checks
